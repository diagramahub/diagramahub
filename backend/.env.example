# DiagramHub Backend Configuration
# Copy this file to .env and fill in your values
# Or run: bash install.sh (recommended - one-line installation)

# ============================================
# MongoDB Configuration
# ============================================

# For local MongoDB (Docker):
MONGO_URI=mongodb://mongodb:27017

# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# For self-hosted MongoDB:
# MONGO_URI=mongodb://username:password@your-server.com:27017/

# Database name
DATABASE_NAME=diagramahub

# ============================================
# JWT Security Configuration
# ============================================

# Generate a secure secret with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_MIN_32_CHARS

# Encryption key for AI provider API keys, integration credentials (email,
# Stripe, Google) and TOTP secrets. Required for those features. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up: if it changes, data encrypted with the old key can't be read.
AI_ENCRYPTION_KEY=

# ============================================
# API Configuration
# ============================================

API_V1_PREFIX=/api/v1

# ============================================
# CORS Configuration
# ============================================

# Comma-separated list of allowed origins (no brackets or quotes).
# When empty, FRONTEND_URL is the only allowed origin.
# For development:
BACKEND_CORS_ORIGINS=http://localhost:5173
# For production (replace with your actual domain):
# BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Application Environment
# ============================================

# Set to "development" for hot reload, "production" for gunicorn
APP_ENV=development

# Port the backend listens on inside the container. The docker-compose files
# set PORT=5172 to match the published port, so leave this commented.
# PORT=5172

# Number of gunicorn workers (production only, default: 2). Rate limits are kept
# in memory per worker, so the effective limit can be up to WORKERS times higher.
# WORKERS=2

# Reverse proxies allowed to set X-Forwarded-For (comma-separated IPs or CIDR
# networks, default: 127.0.0.1,::1). Behind a proxy, set it to the address the
# proxy connects from (e.g. the Docker network gateway, 172.18.0.1) so rate
# limits, lockout and the audit log see the real client IP. Never use "*"
# unless the backend port is reachable only from the proxy.
# FORWARDED_ALLOW_IPS=172.18.0.1

# ============================================
# Stripe Configuration (Subscription System)
# ============================================

# Frontend URL for Stripe Checkout redirects
FRONTEND_URL=http://localhost:5173

# ============================================
# Kroki Configuration (Server-Side Diagram Rendering)
# ============================================

# URL of the Kroki service for rendering PlantUML, D2, and other server-side diagrams.
# Default points to the Kroki Docker container on the internal network.
# Change this if you run Kroki on a different host or port.
KROKI_URL=http://kroki:8000

# ============================================
# Request Limits (Optional)
# ============================================

# Maximum accepted request body in bytes; larger requests get HTTP 413.
# Default 5 MB (large freehand drawings are stored as JSON).
# MAX_REQUEST_BODY_BYTES=5242880

# ============================================
# Sentry Configuration (Optional)
# ============================================

# Sentry DSN for error monitoring. Leave empty to disable Sentry.
SENTRY_DSN=

# Percentage of transactions to capture for performance monitoring (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Logs in Sentry
SENTRY_ENABLE_LOGS=True