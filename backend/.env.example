# DiagramHub Backend Configuration
# Copy this file to .env and fill in your values
# Or run: bash install.sh (recommended - one-line installation)

# ============================================
# MongoDB Configuration
# ============================================

# For local MongoDB (Docker):
MONGO_URI=mongodb://mongodb:27017

# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# For self-hosted MongoDB:
# MONGO_URI=mongodb://username:password@your-server.com:27017/

# Database name
DATABASE_NAME=diagramahub

# ============================================
# JWT Security Configuration
# ============================================

# Generate a secure secret with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_MIN_32_CHARS

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# API Configuration
# ============================================

API_V1_PREFIX=/api/v1

# ============================================
# CORS Configuration
# ============================================

# Comma-separated list of allowed origins
# For development:
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# For production (replace with your actual domain):
# BACKEND_CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# ============================================
# Application Environment
# ============================================

# Set to "development" for hot reload, "production" for gunicorn
APP_ENV=development

# Port the backend will listen on
PORT=8000

# Number of gunicorn workers (production only, default: 2)
# WORKERS=2

# ============================================
# Stripe Configuration (Subscription System)
# ============================================

# Stripe API Keys
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL for Stripe Checkout redirects
FRONTEND_URL=http://localhost:3000
