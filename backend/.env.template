# Project Configuration
PROJECT_NAME=Diagramahub
VERSION=1.0.0

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=diagramahub

# Security Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_ENCRYPTION_KEY= # Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# CORS Configuration (comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Kroki Configuration (Server-Side Diagram Rendering)
# URL of the Kroki service for rendering PlantUML, D2, and other server-side diagrams.
KROKI_URL=http://kroki:8000
