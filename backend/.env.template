# Project Configuration
PROJECT_NAME=Diagramahub

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=diagramahub

# Security Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-characters
JWT_ALGORITHM=HS256
# Encrypts AI provider API keys, integration credentials and TOTP secrets. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=

# CORS Configuration (comma-separated list, no brackets or quotes)
BACKEND_CORS_ORIGINS=http://localhost:5173

# Kroki Configuration (Server-Side Diagram Rendering)
# URL of the Kroki service for rendering PlantUML, D2, and other server-side diagrams.
KROKI_URL=http://kroki:8000

# Request limits (Optional) — max request body in bytes, larger gets HTTP 413 (default 5 MB)
# MAX_REQUEST_BODY_BYTES=5242880

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
